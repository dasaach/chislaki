#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

double f(double x1, double x2)
{
    return x1*x1 + 4*x2*x2 + x1*x2 + x1;
}

double df_dx1(double x1, double x2)
{
    return 2*x1 + x2 + 1;
}

double df_dx2(double x1, double x2)
{
    return x1 + 8*x2;
}

int main()
{
    double x1 = 3;
    double x2 = 1;

    double eps = 0.0001;

    cout << fixed << setprecision(6);

    int iter = 0;

    // Гессиан
    double H[2][2] =
    {
        {2,1},
        {1,8}
    };

    double det = 2*8 - 1*1;

    // обратная матрица
    double invH[2][2];

    invH[0][0] = 8.0/det;
    invH[0][1] = -1.0/det;
    invH[1][0] = -1.0/det;
    invH[1][1] = 2.0/det;

    while(true)
    {
        double g1 = df_dx1(x1,x2);
        double g2 = df_dx2(x1,x2);

        double norm = sqrt(g1*g1 + g2*g2);

        cout << "\n====================================\n";
        cout << "Итерация: " << iter << endl;

        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;

        cout << "\nГрадиент:\n";
        cout << "g1 = " << g1 << endl;
        cout << "g2 = " << g2 << endl;

        if(norm < eps)
        {
            cout << "\nМинимум найден.\n";
            break;
        }

        double dx1 =
            invH[0][0]*g1 +
            invH[0][1]*g2;

        double dx2 =
            invH[1][0]*g1 +
            invH[1][1]*g2;

        cout << "\nПоправка:\n";
        cout << "dx1 = " << dx1 << endl;
        cout << "dx2 = " << dx2 << endl;

        x1 = x1 - dx1;
        x2 = x2 - dx2;

        iter++;
    }

    cout << "\n============================\n";
    cout << "Ответ:\n";
    cout << "x1 = " << x1 << endl;
    cout << "x2 = " << x2 << endl;
    cout << "f = " << f(x1,x2) << endl;
}
