#include <iostream>
#include <cmath>

using namespace std;

const double EPS = 0.5;

struct Point
{
    double x1, x2;
};

double f(Point x)
{
    return x.x1*x.x1 +
           4*x.x2*x.x2 +
           x.x1*x.x2 +
           x.x1;
}

Point grad(Point x)
{
    Point g;

    g.x1 = 2*x.x1 + x.x2 + 1;
    g.x2 = x.x1 + 8*x.x2;

    return g;
}

double norm(Point g)
{
    return sqrt(g.x1*g.x1 + g.x2*g.x2);
}

int main()
{
    Point x = {3,1};

    double prevNorm = 0;

    int k = 0;

    while(true)
    {
        Point g = grad(x);

        double n = norm(g);

        if(n < EPS)
            break;

        // обратная матрица Гессе
        double det = 15.0;

        double h11 = 8.0/det;
        double h12 = -1.0/det;
        double h21 = -1.0/det;
        double h22 = 2.0/det;

        Point step;

        step.x1 = h11*g.x1 + h12*g.x2;
        step.x2 = h21*g.x1 + h22*g.x2;

        // шаг Ньютона
        x.x1 = x.x1 - step.x1;
        x.x2 = x.x2 - step.x2;

        double error =
            fabs(n - prevNorm)/2.0;

        cout << "Iter = " << k+1 << endl;

        cout << "x1 = " << x.x1 << endl;
        cout << "x2 = " << x.x2 << endl;

        cout << "f(x) = "
             << f(x) << endl;

        cout << "||grad|| = "
             << n << endl;

        cout << "error = "
             << error << endl;

        cout << "------------------"
             << endl;

        prevNorm = n;

        k++;
    }

    return 0;
}
