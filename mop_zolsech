import math

def f(x):
    return x**2 + 2  # функция

a = -3
b = 7
eps = 0.5           # точность

phi = (1 + math.sqrt(5)) / 2  # золотое число ≈ 1.618

x1 = b - (b - a) / phi  # первая точка
x2 = a + (b - a) / phi  # вторая точка

while (b - a) > eps:  # пока интервал не стал маленьким
    if f(x1) < f(x2):  # если слева меньше
        b = x2         # сужаем справа
        x2 = x1        # переносим точку
        x1 = b - (b - a) / phi  # считаем новую
    else:
        a = x1         # сужаем слева
        x1 = x2        # перенос точки
        x2 = a + (b - a) / phi  # новая точка

x_min = (a + b) / 2    # итоговая точка
print("x* =", x_min)
print("f(x*) =", f(x_min))
