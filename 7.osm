  <tag k="subject:wikidata" v="Q289805"/>
  <tag k="subject:wikipedia" v="ru:Лебедев, Сергей Васильевич"/>
 </node>
 <node id="6517079216" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9175589" lon="30.3183175">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь с 1889 г. по 1894 г. учился и начал свою революционную работу в марксистском кружке студентов-технологов старейший деятель революционного движения, крупный учёный-энергетик Глеб Максимилианович Кржижановский"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Глеб Максимилианович Кржижановский"/>
  <tag k="name" v="Г. М. Кржижановскому"/>
  <tag k="subject:wikidata" v="Q944478"/>
  <tag k="subject:wikipedia" v="ru:Кржижановский, Глеб Максимилианович"/>
 </node>
 <node id="6517079217" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9178138" lon="30.3182608">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь с 1893 по 1930 год работал выдающийся российский учёный, основоположник электронного телевидения Борис Львович Розинг (1869–1933)"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Борис Львович Розинг"/>
