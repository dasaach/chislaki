 </node>
 <node id="6517079215" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9177298" lon="30.3182646">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь в 1930–1934 годы работал выдающийся советский учёный, создатель синтетического каучука, академик Сергей Васильевич Лебедев (1874–1934)"/>
  <tag k="memorial" v="plaque"/>
