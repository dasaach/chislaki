  <tag k="subject:wikipedia" v="ru:Менделеев, Дмитрий Иванович"/>
 </node>
 <node id="6517079214" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9176880" lon="30.3182666">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь в 1859–1866 годы работал выдающийся русский учёный, основоположник теории металлургических процессов Дмитрий Константинович Чернов (1839–1921)"/>
