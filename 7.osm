 </node>
 <node id="6517079218" visible="true" version="3" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9173529" lon="30.3191358">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В 1905–1906 гг. В.И. Ленин неоднократно выступал в здании Технологического института на партийных собраниях Петербургской социал-демократической организации по вопросам тактики большевиков в буржуазно-демократической революции"/>
  <tag k="inscription_1" v="и принимал участие в заседании Петербургского совета рабочих депутатов"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Владимир Ильич Ленин"/>
  <tag k="name" v="В. И. Ленину"/>
  <tag k="subject:wikidata" v="Q1394"/>
  <tag k="subject:wikipedia" v="ru:Ленин, Владимир Ильич"/>
 </node>
 <node id="6517079219" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9173818" lon="30.3193984">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь, в Технологическом институте, в 1910–1917 гг. учился Николай Петрович Горбунов, советский государственный деятель, один из организаторов науки, академик"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Николай Петрович Горбунов"/>
