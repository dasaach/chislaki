  <tag k="subject:wikipedia" v="ru:Горбунов, Николай Петрович"/>
 </node>
 <node id="6517079220" visible="true" version="2" changeset="114287119" timestamp="2021-11-27T09:00:03Z" user="mini-me" uid="3846961" lat="59.9174344" lon="30.3195440">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь, в Петербургском технологическом институте, в 1874–1875 годах учился Людвик Варыньский — деятель социалистического движения, основатель польской партии «Пролетариат» (1882). Погиб в Шлиссельбургской крепости в 1889 году."/>
  <tag k="memorial" v="plaque"/>
