  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В этом доме в 1906 году находилась легальная большевистская типография товарищества &quot;Дело&quot;. Здесь печатались большевистские газеты &quot;Волна&quot;, &quot;Вперед&quot;, &quot;Эхо&quot; и &quot;Новая волна&quot;. В. И. Ленин неоднократно бывал здесь как редактор этих газет."/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Владимир Ильич Ленин"/>
