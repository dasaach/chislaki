#include <iostream>
#include <fstream>
#include <cmath>
#include <vector>

using namespace std;

// Правая часть ОДУ y' = f(x, y)
double f(double x, double y) {
    return y - x * x + 1;
}

// Точное решение
double exact(double x) {
    return (x + 1) * (x + 1) - 0.5 * exp(x);
}

// Метод Эйлера
vector<pair<double, double>> euler(double x0, double y0, double xn, double h) {
    vector<pair<double, double>> result;

    double x = x0;
    double y = y0;

    while (x <= xn + 1e-9) {
        result.push_back({x, y});
        y = y + h * f(x, y);
        x += h;
    }

    return result;
}

int main() {
    ifstream in("input.txt");
    ofstream out("output.txt");

    double x0, y0, xn, h;
    in >> x0 >> y0 >> xn >> h;

    // Решения
    auto res_h = euler(x0, y0, xn, h);
    auto res_h2 = euler(x0, y0, xn, h / 2);

    out << "x\tEuler(h)\tEuler(h/2)\tExact\tError(h)\n";

    for (size_t i = 0; i < res_h.size(); i++) {
        double x = res_h[i].first;
        double y_h = res_h[i].second;

        double y_exact = exact(x);
        double error = fabs(y_h - y_exact);

        // Для h/2 берем соответствующий индекс
        double y_h2 = res_h2[i * 2].second;

        out << x << "\t"
            << y_h << "\t"
            << y_h2 << "\t"
            << y_exact << "\t"
            << error << "\n";
    }

    in.close();
    out.close();

    return 0;
}
