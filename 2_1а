// Метод Эйлера
// y' - y = 2x - 3
// y' = y + 2x - 3
// Точное решение:
// 2x + y - 1 = e^x
// y = e^x - 2x + 1

#include <iostream>
#include <fstream>
#include <cmath>
#include <iomanip>

using namespace std;

double f(double x, double y)
{
    return y + 2 * x - 3;
}

// ==========================
// Точное решение
// ==========================

double exact_solution(double x)
{
    return exp(x) - 2 * x + 1;
}

// ==========================
// Метод Эйлера
// ==========================

void euler_method(double x0,
    double y0,
    double xn,
    double h,
    ofstream& fout)
{
    double x = x0;
    double y = y0;

    fout << fixed << setprecision(6);

    while (x <= xn + 1e-9)
    {
        double u = exact_solution(x);
        double delta = fabs(y - u);

        // Вывод в формате Excel
        fout << x << "\t"
            << y << "\t"
            << u << "\t"
            << delta << "\n";

        // Метод Эйлера
        y = y + h * f(x, y);
        x = x + h;
    }
}

int main()
{
    ifstream fin("input.txt");
    ofstream fout("output.txt");

    if (!fin.is_open())
    {
        cout << "Ошибка открытия input.txt\n";
        return 1;
    }

    // Формат:
    // x0 y0 xn h1 h2

    double x0, y0, xn, h1, h2;

    fin >> x0 >> y0 >> xn >> h1 >> h2;

    // ==========================
    // Таблица для h1
    // ==========================

    fout << "Численное решение (h=" << h1 << ")\n";
    fout << "x\t y\t u\t delta\n\n";

    euler_method(x0, y0, xn, h1, fout);

    fout << "\n\n";

    // ==========================
    // Таблица для h2
    // ==========================

    fout << "Численное решение (h=" << h2 << ")\n";
    fout << "x\t y\t u\t delta\n\n";

    euler_method(x0, y0, xn, h2, fout);

    fin.close();
    fout.close();

    cout << "Результаты записаны в output.txt\n";

    return 0;
}
