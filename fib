#include <iostream>

using namespace std;

// функция
double f(double x)
{
    return x * x + 2;
}

int main()
{
    double a = -3;
    double b = 7;
    double eps = 0.5;

    // массив чисел Фибоначчи
    int F[50];

    F[0] = 1;
    F[1] = 1;

    int n = 1;

    // заранее вычисляем числа Фибоначчи
    while (true)
    {
        F[n + 1] = F[n] + F[n - 1];

        if (F[n + 1] >= (b - a) / eps)
        {
            n = n + 1;
            break;
        }

        n++;
    }

    // начальные точки
    double x1 =
        a + (double)F[n - 2] / F[n] * (b - a);

    double x2 =
        a + (double)F[n - 1] / F[n] * (b - a);

    // основной цикл
    for (int k = 1; k <= n - 2; k++)
    {
        cout << "Шаг " << k << endl;

        cout << "a = " << a
             << "   b = " << b << endl;

        cout << "x1 = " << x1
             << "   x2 = " << x2 << endl;

        cout << "f(x1) = " << f(x1)
             << "   f(x2) = " << f(x2)
             << endl;

        // погрешность
        double error = (b - a) / 2.0;

        cout << "Погрешность = "
             << error << endl;

        if (f(x1) < f(x2))
        {
            b = x2;

            x2 = x1;

            x1 =
                a + (double)F[n - k - 2] /
                F[n - k] * (b - a);
        }
        else
        {
            a = x1;

            x1 = x2;

            x2 =
                a + (double)F[n - k - 1] /
                F[n - k] * (b - a);
        }

        cout << "-------------------"
             << endl;
    }

    double xmin = (a + b) / 2.0;

    cout << "Минимум x* = "
         << xmin << endl;

    cout << "f(x*) = "
         << f(xmin) << endl;

    return 0;
}
