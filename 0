#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>

using namespace std;

int main() {
    ifstream fin("input.txt");
    ofstream fout("output.txt");

    int n;
    fin >> n;

    vector<vector<double>> A(n, vector<double>(n));
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            fin >> A[i][j];
        }
    }

    vector<double> y(n), y_prev(n);
    for (int i = 0; i < n; i++) {
        fin >> y[i];
    }

    double eps = 1e-6;

    double lambda = 0, lambda_prev = 0;
    int k = 0;

    while (true) {
        k++;
        y_prev = y;

        for (int i = 0; i < n; i++) {
            y[i] = 0;
            for (int j = 0; j < n; j++) {
                y[i] += A[i][j] * y_prev[j];
            }
        }

        for (int i = 0; i < n; i++) {
            if (fabs(y_prev[i]) > 1e-12) {
                lambda = y[i] / y_prev[i];
                break;
            }
        }

        if (fabs(lambda - lambda_prev) < eps)
            break;

        lambda_prev = lambda;
    }

    fout << "Iterations: " << k << endl;
    fout << "Eigenvalue: " << lambda << endl;

    fout << "Eigenvector:" << endl;
    for (int i = 0; i < n; i++) {
        fout << y[i] << " ";
    }

    fin.close();
    fout.close();

    return 0;
}
