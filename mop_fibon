#include <iostream>
#include <vector>
using namespace std;

double f(double x) {
    return x * x + 2;
}

int main() {
    double a = -3, b = 7;
    double eps = 0.5;

    vector<int> fib = {1, 1};
    
    // Защита: гарантируем минимум 3 числа Фибоначчи
    while (fib.size() < 3 || fib.back() < (b - a) / eps) {
        fib.push_back(fib[fib.size() - 1] + fib[fib.size() - 2]);
    }

    int n = fib.size() - 1;
    
    // Дополнительная проверка на допустимость индексов
    if (n < 2) {
        cout << "Ошибка: недостаточно чисел Фибоначчи" << endl;
        return 1;
    }

    double x1 = a + (double)fib[n - 2] / fib[n] * (b - a);
    double x2 = a + (double)fib[n - 1] / fib[n] * (b - a);

    int iter = 0;

    for (int k = 1; k <= n - 1; k++) {  // безопасный диапазон
        iter++;

        cout << "Итерация " << iter << endl;
        cout << "a = " << a << ", b = " << b << endl;
        cout << "x1 = " << x1 << ", x2 = " << x2 << endl;
        cout << "f(x1) = " << f(x1) << ", f(x2) = " << f(x2) << endl;

        if (f(x1) < f(x2)) {
            b = x2;
            x2 = x1;
            if (n - k - 2 >= 0) {  // проверка индекса
                x1 = a + (double)fib[n - k - 2] / fib[n - k] * (b - a);
            }
            cout << "Берем левую часть\n";
        } else {
            a = x1;
            x1 = x2;
            if (n - k - 1 >= 0) {  // проверка индекса
                x2 = a + (double)fib[n - k - 1] / fib[n - k] * (b - a);
            }
            cout << "Берем правую часть\n";
        }

        cout << "Новый отрезок: [" << a << ", " << b << "]\n\n";
    }

    double xmin = (a + b) / 2;
    cout << "Минимум примерно в x = " << xmin << endl;
    cout << "f(x) = " << f(xmin) << endl;

    return 0;
}
