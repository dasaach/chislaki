#include <iostream>
using namespace std;

// функция из задания
double f(double x)
{
    return x * x + 2;
}

int main()
{
    double x0 = 2;   // начальная точка
    double t = 1;    // шаг
    double eps = 0.5;

    // вычисляем три значения функции
    double f1 = f(x0 - t);
    double f2 = f(x0);
    double f3 = f(x0 + t);

    // вывод начальных значений
    cout << "f(x0 - t) = " << f1 << endl;
    cout << "f(x0) = " << f2 << endl;
    cout << "f(x0 + t) = " << f3 << endl;

    // проверяем направление движения
    if (f1 >= f2 && f2 <= f3)
    {
        // минимум уже внутри интервала
        cout << "Интервал неопределенности: ["
             << x0 - t << " ; " << x0 + t << "]" << endl;
    }
    else if (f1 < f2 && f2 < f3)
    {
        // минимум слева
        double x1 = x0 - t;

        // увеличиваем шаг
        double x2 = x1 - 2 * t;

        cout << "Движение влево" << endl;

        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;

        // вывод найденного интервала
        cout << "Интервал неопределенности: ["
             << x2 << " ; " << x0 << "]" << endl;
    }
    else
    {
        // минимум справа
        double x1 = x0 + t;

        // увеличиваем шаг
        double x2 = x1 + 2 * t;

        cout << "Движение вправо" << endl;

        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;

        // вывод найденного интервала
        cout << "Интервал неопределенности: ["
             << x0 << " ; " << x2 << "]" << endl;
    }

    return 0;
}
