# pip install transformers torch

from transformers import pipeline

# =========================================
# Загрузка модели
# =========================================

chatbot = pipeline(
    "text-generation",
    model="sberbank-ai/rugpt3small_based_on_gpt2"
)

# =========================================
# Диалог
# =========================================

print("Введите 'выход' для завершения")

while True:

    user_input = input("Вы: ")

    if user_input.lower() == "выход":
        break

    result = chatbot(
        user_input,
        max_length=80,
        do_sample=True,
        temperature=0.8,
        top_k=50
    )

    print("Бот:", result[0]["generated_text"])

