import torch
import torch.nn as nn
import torch.optim as optim

import torchvision
from torchvision import transforms

from sklearn.metrics import classification_report

# -----------------------------------
# Подготовка данных
# -----------------------------------

transform = transforms.Compose([
    transforms.ToTensor()
])

trainset = torchvision.datasets.FashionMNIST(
    root='./data',
    train=True,
    download=True,
    transform=transform
)

trainloader = torch.utils.data.DataLoader(
    trainset,
    batch_size=64,
    shuffle=True
)

testset = torchvision.datasets.FashionMNIST(
    root='./data',
    train=False,
    download=True,
    transform=transform
)

testloader = torch.utils.data.DataLoader(
    testset,
    batch_size=64,
    shuffle=False
)

# -----------------------------------
# Названия классов
# -----------------------------------

classes = (
    'T-shirt/top',
    'Trouser',
    'Pullover',
    'Dress',
    'Coat',
    'Sandal',
    'Shirt',
    'Sneaker',
    'Bag',
    'Ankle boot'
)

# -----------------------------------
# Модель
# -----------------------------------

model = nn.Sequential(

    nn.Flatten(),

    nn.Linear(784, 256),
    nn.ReLU(),

    nn.Linear(256, 128),
    nn.ReLU(),

    nn.Linear(128, 10)
)

# -----------------------------------
# Функция ошибки и оптимизатор
# -----------------------------------

criterion = nn.CrossEntropyLoss()

optimizer = optim.Adam(
    model.parameters(),
    lr=0.001
)

# -----------------------------------
# Обучение
# -----------------------------------

epochs = 15

for epoch in range(epochs):

    running_loss = 0.0

    for images, labels in trainloader:

        optimizer.zero_grad()

        outputs = model(images)

        loss = criterion(outputs, labels)

        loss.backward()

        optimizer.step()

        running_loss += loss.item()

    print(f'Эпоха {epoch+1}, Loss: {running_loss:.4f}')

print('Обучение завершено')

# -----------------------------------
# Проверка модели
# -----------------------------------

y_true = []
y_pred = []

with torch.no_grad():

    for images, labels in testloader:

        outputs = model(images)

        _, predicted = torch.max(outputs, 1)

        y_true.extend(labels.numpy())

        y_pred.extend(predicted.numpy())

# -----------------------------------
# Отчет по точности классов
# -----------------------------------

report = classification_report(
    y_true,
    y_pred,
    target_names=classes,
    output_dict=True
)

print('\nТочность по классам:\n')

for class_name in classes:

    accuracy = report[class_name]['recall'] * 100

    status = '>= 70%' if accuracy >= 70 else '< 70%'

    print(f'{class_name}: {accuracy:.2f}%  {status}')
