#include <iostream>
#include <fstream>
#include <vector>
#include <cmath>
#include <locale>

using namespace std;

const double PI = 3.141592653589793;

int main()
{
    setlocale(LC_ALL, "Russian");

    ifstream fin("input.txt");
    ofstream fout("output.txt");

    double a, L;
    int N, K;

    // ввод данных
    fin >> a;
    fin >> L;
    fin >> N;
    fin >> K;

    double h = L / N;

    // шаг по времени
    double tau = 0.45 * h * h / (a * a);

    double r = a * a * tau / (h * h);

    vector<double> u(N + 1);
    vector<double> new_u(N + 1);

    // начальное условие:
    // u(x,0)=sin(2*pi*x)

    for (int i = 0; i <= N; i++)
    {
        double x = i * h;

        u[i] = sin(PI * x);
    }

    // вычисления
    for (int j = 1; j <= K; j++)
    {
        // граничные условия
        new_u[0] = 0;
        new_u[N] = 0;

        // явная схема
        for (int i = 1; i < N; i++)
        {
            new_u[i] =
                u[i]
                + r * (
                    u[i + 1]
                    - 2 * u[i]
                    + u[i - 1]
                    );
        }

        u = new_u;
    }

    double t = K * tau;

    fout << "x u_chisl u_toch pogresh\n";

    double maxError = 0;

    // вывод 40 значений
    for (int k = 0; k < 20; k++)
    {
        int i = k * N / 19;

        double x = i * h;

        // точное решение:
        // u(x,t)=exp(-16*pi*pi*t)*sin(2*pi*x)

        double exact =
            exp(-PI * PI * t)
            * sin(PI * x);

        double error =
            abs(u[i] - exact);

        if (error > maxError)
        {
            maxError = error;
        }

        // вывод с запятыми
        char buffer[200];

        sprintf_s(
            buffer,
            "%.6f %.6f %.6f %.6f",
            x,
            u[i],
            exact,
            error
        );

        for (int j = 0; buffer[j] != '\0'; j++)
        {
            if (buffer[j] == '.')
            {
                buffer[j] = ',';
            }
        }

        fout << buffer << "\n";
    }

    fout << "\n";

    char buffer2[100];

    sprintf_s(buffer2, "%.6f", maxError);

    for (int j = 0; buffer2[j] != '\0'; j++)
    {
        if (buffer2[j] == '.')
        {
            buffer2[j] = ',';
        }
    }

    fout << "max_pogresh = "
        << buffer2;

    fin.close();
    fout.close();

    return 0;
}

