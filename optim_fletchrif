#include <iostream>
#include <cmath>

using namespace std;

const double EPS = 0.5;
const double ALPHA = 0.1;

struct Point
{
    double x1, x2;
};

double f(Point x)
{
    return x.x1*x.x1 +
           4*x.x2*x.x2 +
           x.x1*x.x2 +
           x.x1;
}

Point grad(Point x)
{
    Point g;

    g.x1 = 2*x.x1 + x.x2 + 1;
    g.x2 = x.x1 + 8*x.x2;

    return g;
}

double norm(Point g)
{
    return sqrt(g.x1*g.x1 + g.x2*g.x2);
}

double dot(Point a, Point b)
{
    return a.x1*b.x1 + a.x2*b.x2;
}

int main()
{
    Point x = {3,1};

    Point g = grad(x);

    // начальное направление
    Point d;

    d.x1 = -g.x1;
    d.x2 = -g.x2;

    double prevNorm = 0;

    int k = 0;

    while(true)
    {
        double n = norm(g);

        if(n < EPS)
            break;

        // движение по сопряжённому направлению
        x.x1 = x.x1 + ALPHA*d.x1;
        x.x2 = x.x2 + ALPHA*d.x2;

        Point gNew = grad(x);

        double beta =
            dot(gNew,gNew) /
            dot(g,g);

        // новое сопряжённое направление
        d.x1 = -gNew.x1 + beta*d.x1;
        d.x2 = -gNew.x2 + beta*d.x2;

        double error =
            fabs(n - prevNorm)/2.0;

        cout << "Iter = " << k+1 << endl;

        cout << "x1 = " << x.x1 << endl;
        cout << "x2 = " << x.x2 << endl;

        cout << "f(x) = "
             << f(x) << endl;

        cout << "||grad|| = "
             << n << endl;

        cout << "error = "
             << error << endl;

        cout << "------------------"
             << endl;

        prevNorm = n;

        g = gNew;

        k++;
    }

    return 0;
}
