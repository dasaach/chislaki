#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

double f(double x1, double x2)
{
    return x1*x1 + 4*x2*x2 + x1*x2 + x1;
}

double df_dx1(double x1, double x2)
{
    return 2*x1 + x2 + 1;
}

double df_dx2(double x1, double x2)
{
    return x1 + 8*x2;
}

int main()
{
    double x1 = 3;
    double x2 = 1;

    double eps = 0.0001;

    int iter = 0;

    cout << fixed << setprecision(6);

    while(true)
    {
        double g1 = df_dx1(x1, x2);
        double g2 = df_dx2(x1, x2);

        double norm = sqrt(g1*g1 + g2*g2);

        cout << "\n===================================\n";
        cout << "Итерация: " << iter << endl;

        cout << "Текущая точка:\n";
        cout << "x1 = " << x1 << endl;
        cout << "x2 = " << x2 << endl;

        cout << "\nГрадиент:\n";
        cout << "g1 = " << g1 << endl;
        cout << "g2 = " << g2 << endl;

        cout << "\nНорма градиента = " << norm << endl;

        if(norm < eps)
        {
            cout << "\nМинимум найден.\n";
            break;
        }

        // Направление спуска
        double d1 = -g1;
        double d2 = -g2;

        cout << "\nНаправление спуска:\n";
        cout << "d1 = " << d1 << endl;
        cout << "d2 = " << d2 << endl;

        // Поиск alpha аналитически
        double A =
            d1*d1 +
            4*d2*d2 +
            d1*d2;

        double B =
            2*x1*d1 +
            8*x2*d2 +
            x1*d2 +
            x2*d1 +
            d1;

        double alpha = -B / (2*A);

        cout << "\nПоиск шага alpha:\n";
        cout << "alpha = " << alpha << endl;

        // Новая точка
        double new_x1 = x1 + alpha*d1;
        double new_x2 = x2 + alpha*d2;

        cout << "\nНовая точка:\n";
        cout << "x1_new = " << new_x1 << endl;
        cout << "x2_new = " << new_x2 << endl;

        x1 = new_x1;
        x2 = new_x2;

        iter++;
    }

    cout << "\n===============================\n";
    cout << "Ответ:\n";
    cout << "x1 = " << x1 << endl;
    cout << "x2 = " << x2 << endl;
    cout << "f = " << f(x1,x2) << endl;

    return 0;
}
