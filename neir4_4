# -----------------------------------
# LeakyReLU вместо ReLU
# -----------------------------------

def leaky_relu(x, alpha=0.01):
    return np.where(x > 0, x, alpha * x)

class NeuronLeakyReLU:

    def __init__(self, w=None, b=0, alpha=0.01):

        self.w = w

        self.b = b

        self.alpha = alpha

    def forward_pass(self, X):

        z = X @ self.w + self.b

        return leaky_relu(z, self.alpha)

    def backward_pass(self, X, y, y_pred, learning_rate=0.01):

        n = len(y)

        y = np.array(y).reshape(-1, 1)

        z = X @ self.w + self.b

        # производная LeakyReLU
        leaky_grad = np.where(z > 0, 1, self.alpha)

        error = y_pred - y

        dw = (X.T @ (error * leaky_grad)) / n

        db = np.mean(error * leaky_grad)

        self.w -= learning_rate * dw

        self.b -= learning_rate * db

    def fit(self, X, y, num_epochs=500, learning_rate=0.01):

        self.w = np.random.randn(X.shape[1], 1) * 0.01

        self.b = np.random.randn(1) * 0.01

        losses = []

        for i in range(num_epochs):

            y_pred = self.forward_pass(X)

            losses.append(Loss(y_pred, y))

            self.backward_pass(X, y, y_pred, learning_rate)

        return losses

