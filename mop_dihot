#include <iostream>
#include <cmath>
using namespace std;

double f(double x) {
    return x * x + 2;
}

int main() {
    setlocale(LC_ALL, "ru");
    double a = -3, b = 7;
    double eps = 0.5;
    double delta = eps/2;
    int iter = 0;

    while ((b - a) / 2 > eps) {
        iter++;

        double mid = (a + b) / 2;
        double x1 = mid - delta;
        double x2 = mid + delta;

        cout << "Итерация " << iter << endl;
        cout << "a = " << a << ", b = " << b << endl;
        cout << "x1 = " << x1 << ", x2 = " << x2 << endl;
        cout << "f(x1) = " << f(x1) << ", f(x2) = " << f(x2) << endl;

        if (f(x1) < f(x2)) {
            b = x2;
            cout << "Берем левую часть\n";
        }
        else {
            a = x1;
            cout << "Берем правую часть\n";
        }

        cout << "Новый отрезок: [" << a << ", " << b << "]\n\n";
    }

    double xmin = (a + b) / 2;
    cout << "Погрешность " << abs((b - a) / 2) << "\n";
    cout << "Минимум примерно в x = " << xmin << endl;
    cout << "f(x) = " << f(xmin) << endl;

    return 0;
}
