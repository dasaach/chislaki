def f(x):
    return x**2 + 2

a = -3
b = 7
eps = 0.5

while (b - a) > eps*2:
    y = (a + b-eps) / 2
    z = (a + b+eps) / 2

    if f(y) < f(z):
        b = z
        print("f(y)=",f(y)," <  f(z)=",f(z),"\n", "y=",y, "   b=z=",z, "   a=",a)
        print("Длина",b-a,"\n")
    else:
        a = y
        print("f(y)=",f(y),"  >=  f(z)=",f(z),"\n","    a=y=",y, "   z=",z, "   b=",b)
        print("Длина",b-a,"\n")


x_min = (a + b) / 2
print("x* =", x_min,"+-",(b -a) / 2)
print("f(x*) =", f(x_min))
