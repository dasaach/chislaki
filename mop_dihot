def f(x):
    return x**2 + 2  # функция из задания

a = -3      # левая граница интервала
b = 7       # правая граница интервала
delta = 0.2 # малое смещение
eps = 0.5   # точность (условие остановки)

while (b - a) > eps:  # пока интервал больше точности
    x1 = (a + b) / 2 - delta  # точка слева от середины
    x2 = (a + b) / 2 + delta  # точка справа от середины

    if f(x1) < f(x2):  # если слева значение меньше
        b = x2         # сдвигаем правую границу (берём левую часть)
    else:
        a = x1         # иначе берём правую часть

x_min = (a + b) / 2    # середина последнего интервала
print("x* =", x_min)   # вывод точки минимума
print("f(x*) =", f(x_min))  # значение функции
