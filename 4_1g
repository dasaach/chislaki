#include <iostream>
#include <fstream>
#include <cmath>

using namespace std;

// p(x)
double p(double x)
{
    return x;
}

// f(x)
double func(double x)
{
    return x * x;
}

double F1(double x, double y1, double y2)
{
    return y2;
}

double F2(double x, double y1, double y2)
{
    return p(x) * y1 + func(x);
}

// Метод Рунге-Кутты с выводом таблицы
double rungeKutta(double a, double b,
                  double alpha,
                  double t,
                  int n,
                  ofstream& fout)
{
    double h = (b - a) / n;

    double x = a;
    double y1 = alpha;
    double y2 = t;

    fout << "x\t\t y(x)\t\t y'(x)" << endl;

    fout << x << "\t\t"
         << y1 << "\t\t"
         << y2 << endl;

    for (int i = 0; i < n; i++)
    {
        double k1y1 = h * F1(x, y1, y2);
        double k1y2 = h * F2(x, y1, y2);

        double k2y1 = h * F1(x + h / 2,
                             y1 + k1y1 / 2,
                             y2 + k1y2 / 2);

        double k2y2 = h * F2(x + h / 2,
                             y1 + k1y1 / 2,
                             y2 + k1y2 / 2);

        double k3y1 = h * F1(x + h / 2,
                             y1 + k2y1 / 2,
                             y2 + k2y2 / 2);

        double k3y2 = h * F2(x + h / 2,
                             y1 + k2y1 / 2,
                             y2 + k2y2 / 2);

        double k4y1 = h * F1(x + h,
                             y1 + k3y1,
                             y2 + k3y2);

        double k4y2 = h * F2(x + h,
                             y1 + k3y1,
                             y2 + k3y2);

        y1 += (k1y1 + 2 * k2y1 +
               2 * k3y1 + k4y1) / 6;

        y2 += (k1y2 + 2 * k2y2 +
               2 * k3y2 + k4y2) / 6;

        x += h;

        fout << x << "\t\t"
             << y1 << "\t\t"
             << y2 << endl;
    }

    return y1;
}

int main()
{
    ifstream fin("input.txt");
    ofstream fout("output.txt");

    double a, b;
    double alpha, beta;
    int n;
    double eps;

    fin >> a >> b;
    fin >> alpha >> beta;
    fin >> n;
    fin >> eps;

    double t1 = -100;
    double t2 = 100;

    double F_t1 = rungeKutta(a, b, alpha,
                             t1, n, fout) - beta;

    fout << endl;

    double F_t2 = rungeKutta(a, b, alpha,
                             t2, n, fout) - beta;

    while (fabs(t2 - t1) > eps)
    {
        double tm = (t1 + t2) / 2;

        ofstream temp("temp.txt");

        double F_tm = rungeKutta(a, b, alpha,
                                 tm, n, temp) - beta;

        temp.close();

        if (F_t1 * F_tm < 0)
        {
            t2 = tm;
            F_t2 = F_tm;
        }
        else
        {
            t1 = tm;
            F_t1 = F_tm;
        }
    }

    double t = (t1 + t2) / 2;

    fout << endl;
    fout << "Найденное значение y'(a): "
         << t << endl << endl;

    fout << "Финальное решение:" << endl;

    rungeKutta(a, b, alpha,
               t, n, fout);

    fin.close();
    fout.close();

    return 0;
}
