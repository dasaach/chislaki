#include <iostream>
#include <fstream>
#include <cmath>
#include <iomanip>

using namespace std;

// p(x)
double p(double x)
{
    return -1.0;
}

// f(x)
double func(double x)
{
    return 0.0;
}

// Точное решение
double exact(double x)
{
    return cos(x);
}

// y1' = y2
double F1(double x, double y1, double y2)
{
    return y2;
}

// y2' = p(x)*y1 + f(x)
double F2(double x, double y1, double y2)
{
    return p(x) * y1 + func(x);
}

// Метод Эйлера
double euler(double a,
    double b,
    double alpha,
    double t,
    int n,
    ofstream& fout,
    bool print)
{
    double h = (b - a) / n;

    double x = a;

    double y1 = alpha;
    double y2 = t;

    if (print)
    {
        fout << fixed << setprecision(10);

        fout << "x\t\t"
            << "u(x)\t\t"
            << "exact\t\t"
            << "error"
            << endl;

        fout << x << "\t\t"
            << y1 << "\t\t"
            << exact(x) << "\t\t"
            << fabs(y1 - exact(x))
            << endl;
    }

    for (int i = 0; i < n; i++)
    {
        double old_y1 = y1;

        y1 = y1 + h * y2;

        y2 = y2 + h * F2(x, old_y1, y2);

        x += h;

        if (print)
        {
            fout << x << "\t\t"
                << y1 << "\t\t"
                << exact(x) << "\t\t"
                << fabs(y1 - exact(x))
                << endl;
        }
    }

    return y1;
}

int main()
{
    ifstream fin("input.txt");
    ofstream fout("output.txt");

    double a, b;
    double alpha, beta;
    int n;
    double eps;

    fin >> a >> b;
    fin >> alpha >> beta;
    fin >> n;
    fin >> eps;

    double t1 = -10;
    double t2 = 10;

    double F_t1 =
        euler(a, b,
            alpha,
            t1,
            n,
            fout,
            false) - beta;

    double F_t2 =
        euler(a, b,
            alpha,
            t2,
            n,
            fout,
            false) - beta;

    // Проверка наличия корня
    if (F_t1 * F_t2 > 0)
    {
        fout << "Корень не найден"
            << endl;

        return 1;
    }

    // Метод дихотомии
    while (fabs(t2 - t1) > eps)
    {
        double tm = (t1 + t2) / 2;

        double F_tm =
            euler(a, b,
                alpha,
                tm,
                n,
                fout,
                false) - beta;

        if (F_t1 * F_tm < 0)
        {
            t2 = tm;
            F_t2 = F_tm;
        }
        else
        {
            t1 = tm;
            F_t1 = F_tm;
        }
    }

    double t = (t1 + t2) / 2;

    fout << "Найденное значение y'(0): "
        << t << endl << endl;

    euler(a, b,
        alpha,
        t,
        n,
        fout,
        true);

    fin.close();
    fout.close();

    return 0;
}



